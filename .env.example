# =============================================================================
# MF Intelligence Dashboard — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# LLM API Keys
# -----------------------------------------------------------------------------
# At least one key is required for AI features (chat, explain, fund summary).
# All other features (charts, analytics, data browsing) work without any keys.

# Gemini API key — powers AI chat and fund summary
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Express server port (default: 3001)
PORT=3001

# Environment mode: "development" or "production"
# In production, Express serves the built React app from client/dist/
NODE_ENV=development

# -----------------------------------------------------------------------------
# Google OAuth (required for authentication)
# -----------------------------------------------------------------------------
# Set up at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT secret for session tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# Admin email — this Google account gets access to Admin panel
ADMIN_EMAIL=

# Public URL of the app (used for OAuth redirect)
APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Razorpay Payment Gateway (required for Pro subscriptions)
# -----------------------------------------------------------------------------
# Set up at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
